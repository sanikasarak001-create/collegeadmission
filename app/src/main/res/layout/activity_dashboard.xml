<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══ HEADER WITH AVATAR ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1565C0"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Name + Welcome -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWelcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back,"
                        android:textColor="#BBDEFB"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Logout icon -->
                <ImageView
                    android:id="@+id/ivLogout"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="12dp"
                    app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="Logout"
                    app:tint="#BBDEFB" />

                <!-- Avatar Button -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardAvatarBtn"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#1976D2">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:background="#1976D2">

                            <TextView
                                android:id="@+id/tvInitials"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/initial_placeholder"
                                android:textColor="#E3F2FD"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Profile"
                        android:textColor="#BBDEFB"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Profile completion bar -->
            <TextView
                android:id="@+id/tvCompletionPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:text="Complete your profile"
                android:textColor="#BBDEFB"
                android:textSize="11sp" />

            <ProgressBar
                android:id="@+id/progressCompletion"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#64B5F6"
                android:progressBackgroundTint="#1976D2" />
        </LinearLayout>

        <!-- ═══ BANNER CARD ═══ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E3F2FD"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎓 Find Your Perfect College"
                    android:textColor="#1565C0"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Enter marks → get matched colleges instantly"
                    android:textColor="#1976D2"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═══ QUICK ACTIONS ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp"
            android:text="Quick Actions"
            android:textColor="#212121"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardPredict"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="#1565C0" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔍" android:textSize="32sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="Predict" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardBrowse"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="#00897B" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏫" android:textSize="32sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="Browse" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardBookmark"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="#E53935" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="❤️" android:textSize="32sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="Saved" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardDeadline"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="#F57F17" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏰" android:textSize="32sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="Deadlines" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ═══ STUDENT TOOLS SECTION ═══ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="Student Tools"
            android:textColor="#212121"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
            <androidx.cardview.widget.CardView android:id="@+id/cardExam" android:layout_width="0dp" android:layout_height="100dp"
                android:layout_weight="1" android:layout_marginEnd="6dp" app:cardCornerRadius="14dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="#1A237E" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📝" android:textSize="24sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="Entrance" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardTrend" android:layout_width="0dp" android:layout_height="100dp"
                android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" app:cardCornerRadius="14dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="#4A148C" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📊" android:textSize="24sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="Trends" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardFee" android:layout_width="0dp" android:layout_height="100dp"
                android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" app:cardCornerRadius="14dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="#1B5E20" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💰" android:textSize="24sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="Fees" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardScholarship" android:layout_width="0dp" android:layout_height="100dp"
                android:layout_weight="1" android:layout_marginStart="6dp" app:cardCornerRadius="14dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="#6A1B9A" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎓" android:textSize="24sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="Scholar" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="16dp">
            <androidx.cardview.widget.CardView android:id="@+id/cardRanking" android:layout_width="0dp" android:layout_height="100dp"
                android:layout_weight="1" android:layout_marginEnd="6dp" app:cardCornerRadius="14dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="#B71C1C" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏆" android:textSize="24sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="Rankings" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardChecklist" android:layout_width="0dp" android:layout_height="100dp"
                android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" app:cardCornerRadius="14dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="#004D40" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅" android:textSize="24sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="Checklist" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardAi" android:layout_width="0dp" android:layout_height="100dp"
                android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" app:cardCornerRadius="14dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="#263238" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🤖" android:textSize="24sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="AI Guide" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/cardNearMe" android:layout_width="0dp" android:layout_height="100dp"
                android:layout_weight="1" android:layout_marginStart="6dp" app:cardCornerRadius="14dp" app:cardElevation="3dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="#01579B" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📍" android:textSize="24sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
                        android:text="Near Me" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>